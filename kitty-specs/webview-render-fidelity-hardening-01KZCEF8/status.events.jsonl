{"aggregate_id": "01KZCEF8PV9K67ZMFTABBHXHK1", "aggregate_type": "Mission", "event_id": "01KZCEF9GKRPYKQRV7Y5RNP8YB", "event_type": "MissionCreated", "payload": {"created_at": "2026-08-06T21:08:07.004857+00:00", "friendly_name": "Webview Render Fidelity and Error-Path Hardening", "mission_id": "01KZCEF8PV9K67ZMFTABBHXHK1", "mission_number": null, "mission_slug": "webview-render-fidelity-hardening-01KZCEF8", "mission_type": "software-dev", "purpose_context": "Post-merge review of the webview shell cutover returned FAIL on two HIGH findings: the production Content-Security-Policy silently blocks the JS-built inline styles that paint fader fills and position indicators, and the typed page-render-failure channel has a listener but no emitter, so page render exceptions vanish silently. Both shipped because the acceptance harness measured a laxer policy than production and no proof exercised the error path. This mission fixes exactly those two defects and hardens the proofs so neither can regress unseen, leaving the review's structural and dead-code items to a separate hygiene mission.", "purpose_tldr": "Fix the shipped webview's CSP-blocked fader rendering and silent page render failures, and close the two proof gaps that let both ship.", "target_branch": "feat/webview-shell-cutover", "wp_count": 0}, "project_slug": "crest-synth", "project_uuid": "6e0c305b-555b-4c71-860a-5598a2a763ea", "schema_version": "5.0.0", "timestamp": "2026-08-06T21:08:07.827974+00:00"}
