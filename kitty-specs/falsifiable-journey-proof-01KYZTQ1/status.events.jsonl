{"aggregate_id": "01KYZTQ118MXZGD4MBCR99A978", "aggregate_type": "Mission", "event_id": "01KYZTQ1RZ0ZVGHKSQ1N8KE8T2", "event_type": "MissionCreated", "payload": {"created_at": "2026-08-01T23:31:56.585328+00:00", "friendly_name": "Falsifiable Journey Proof", "mission_id": "01KYZTQ118MXZGD4MBCR99A978", "mission_number": null, "mission_slug": "falsifiable-journey-proof-01KYZTQ1", "mission_type": "software-dev", "purpose_context": "The previous mission reworked the demo so effect-slot changes travel the player's on-screen PATCH and MIXER journey, and proved it on physical hardware. But its guards assert over what the scene declared rather than what the application actually dispatched, so reverting the fix leaves every test passing and every recorded artifact byte-identical. This mission makes those guards falsifiable \u2014 each is accepted only after its failure has been observed \u2014 so the demonstrated journey cannot regress unnoticed.", "purpose_tldr": "Make the live-demo guards able to fail, so a silently-lost player journey is caught instead of shipped green.", "target_branch": "feat/expandable-effects-and-bus-topology", "wp_count": 0}, "project_slug": "crest-synth", "project_uuid": "6e0c305b-555b-4c71-860a-5598a2a763ea", "schema_version": "5.0.0", "timestamp": "2026-08-01T23:31:57.343447+00:00"}
