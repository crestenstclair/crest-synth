{"aggregate_id": "01KZERV946GWEEMVZZM43EJ437", "aggregate_type": "Mission", "event_id": "01KZERV9Z9A2SHPVZCC6K8RQX5", "event_type": "MissionCreated", "payload": {"created_at": "2026-08-07T18:47:55.271646+00:00", "friendly_name": "Functional Patch Editor Blockout", "mission_id": "01KZERV946GWEEMVZZM43EJ437", "mission_number": null, "mission_slug": "functional-patch-editor-01KZERV9", "mission_type": "software-dev", "purpose_context": "The synth loads fifteen instruments but the controller can only edit the first one. This mission assembles the full PATCH editing experience in the webview shell \u2014 patch identity and routing, instrument selection, ordered effects, the ADSR block, and a persistent Utility panel \u2014 and supplies the state behind the designed-but-undriven controls carried forward from the component library phase. It closes with a live hardware demonstration that navigates from one patch to another and edits a second instrument audibly, which is the outstanding half of the long-standing single-instrument limitation.", "purpose_tldr": "Make every installed instrument reachable and editable from the PATCH surface, and prove it on hardware.", "target_branch": "feat/functional-patch-editor", "wp_count": 0}, "project_slug": "crest-synth", "project_uuid": "6e0c305b-555b-4c71-860a-5598a2a763ea", "schema_version": "5.0.0", "timestamp": "2026-08-07T18:47:56.137859+00:00"}
